KNOWN_HOSTS = {
    "github.com", "gitlab.com", "sourceforge.net", "gnu.org", "kernel.org",
    "pypi.org", "files.pythonhosted.org", "crates.io", "registry.npmjs.org",
    "npmjs.com", "codeberg.org", "bitbucket.org",
}

def extract_scalar(text, varname):
    # ^ (line-start, MULTILINE) rather than a word-boundary lookbehind: a
    # lookbehind alone would still match "depends=" inside "makedepends=",
    # AND - the bug this exact line once had - would match a commented-out
    # "# install=old.install" too, since the character before "install" in
    # a comment is just a space, which a word-boundary check treats as fine.
    # PKGBUILD assignments are conventionally at column 0; requiring that
    # rules out both problems at once.
    m = re.search(rf'^{re.escape(varname)}=(.+)$', text, re.MULTILINE)
    if not m:
        return None
    return m.group(1).strip().strip('"\'')

def extract_array(text, varname):
    # See extract_scalar for why this is ^-anchored rather than a lookbehind.
    m = re.search(rf'^{re.escape(varname)}=\(([^)]*)\)', text, re.MULTILINE | re.DOTALL)
    if not m:
        scalar = extract_scalar(text, varname)
        return [scalar] if scalar else []
    try:
        return shlex.split(m.group(1), comments=True)
    except ValueError:
        return m.group(1).split()

FUNCTION_PARENS_RE = re.compile(r"[ \t]*\([ \t]*\)\s*")

def extract_function(text, funcname):
    """(body, complete) for `funcname() { ... }` or `function funcname
    { ... }`, found with the shared lexer so braces inside quotes, escapes
    (printf \\}), comments, heredocs, and substitutions don't count, and
    only { / } words in command position open or close a group. A
    commented-out or quoted definition can't be matched. body is None if
    there is no such function; complete is False if its end couldn't be
    found, in which case body runs to the end of the text."""
    lex = lex_shell(text)
    words = lex.words
    for i, (start, end, raw, command_position) in enumerate(words):
        if raw != funcname or i + 1 >= len(words):
            continue
        after_keyword = i > 0 and words[i - 1][2] == "function" and words[i - 1][3]
        if not (command_position or after_keyword):
            continue
        open_start, open_end, open_raw, open_cmd = words[i + 1]
        if open_raw != "{" or not open_cmd:
            continue
        between = text[end:open_start]
        if not (FUNCTION_PARENS_RE.fullmatch(between) or (after_keyword and not between.strip())):
            continue
        depth = 0
        for w_start, _, w_raw, w_cmd in words[i + 1:]:
            if not w_cmd:
                continue
            if w_raw == "{":
                depth += 1
            elif w_raw == "}":
                depth -= 1
                if depth == 0:
                    return text[open_end:w_start], lex.complete
        return text[open_end:], False
    return None, True

def extract_function_body(text, funcname):
    return extract_function(text, funcname)[0]

# --- install script discovery -------------------------------------------
# An install script runs as root, so missing one is a false "safe". Rather
# than trust the resolver to find every declaration, discovery is paired
# with a backstop: any lexed statement or heredoc line that could set
# `install` but isn't a declaration this code fully understands is reported
# as unaccounted for. The backstop is best-effort, not a guarantee: it sees
# what the lexer sees, and text built at runtime (eval of constructed
# strings, sourcing other files) is out of its reach - eval is flagged by
# the red-flag scan instead.

MAX_EXPANSIONS = 16

def setter_texts(pkgbuild):
    """(is_code, text) for every lexed statement (comments removed,
    continuations joined) and every heredoc body line."""
    lex = lex_shell(pkgbuild)
    return ([(True, t) for _, t in lex.statements] +
            [(False, t) for _, t in lex.heredoc_lines])

def setter_re(var):
    """Anything that could assign `var`: plain/append/indexed assignment,
    printf -v, and declare-style builtins naming it as an argument or as a
    nameref target (`declare -n ref=var`)."""
    v = re.escape(var)
    return re.compile(
        rf"(?<![\w-]){v}(?:\[[^\]]*\])?\s*\+?="
        rf"|\bprintf\b[^\n;&|]*-v\s*['\"]?{v}(?![-.\w])"
        rf"|\b(?:read|declare|typeset|local|export|readonly|mapfile|readarray|unset)\b"
        rf"(?:\s+[^\s;&|]+?)*?(?:\s+|=)['\"]?{v}(?![-.\w])"
    )

# One shell word: unquoted characters without operators/expansions that
# can't be followed statically, backslash escapes, or complete quotes.
SHELL_WORD = r"""(?:[^\s;&|<>()#'"\\`]|\\.|'[^']*'|"(?:[^"\\]|\\.)*")*"""
INSTALL_DECL_RE = re.compile(rf"\s*install=(?P<word>{SHELL_WORD})\s*")
PKGNAME_CHARS_RE = re.compile(r"^[A-Za-z0-9@._+-]+$")

def expand_word(word, lookup):
    """Every value `word` can statically take, applying bash quoting: no
    expansion inside single quotes, and $var/${var} replaced by
    lookup(var)'s candidate values elsewhere. Returns a sorted list, or None
    if any part (command substitution, ${var%...}, unknown variables,
    leading ~) can't be resolved with confidence."""
    results = [""]
    quote = None
    i = 0
    while i < len(word):
        c = word[i]
        if quote == "'":
            if c == "'":
                quote = None
            else:
                results = [r + c for r in results]
            i += 1
        elif c == "\\":
            if i + 1 >= len(word):
                return None
            nxt = word[i + 1]
            if quote == '"' and nxt not in '$`"\\':
                results = [r + c for r in results]
                i += 1
            else:
                results = [r + nxt for r in results]
                i += 2
        elif c == "'" and quote is None:
            quote = "'"
            i += 1
        elif c == '"':
            quote = None if quote == '"' else '"'
            i += 1
        elif c == "$":
            m = re.match(r"\$(?:\{([A-Za-z_]\w*)\}|([A-Za-z_]\w*))", word[i:])
            values = lookup(m.group(1) or m.group(2)) if m else None
            if not values:
                return None
            results = [r + v for r in results for v in values]
            if len(results) > MAX_EXPANSIONS:
                return None
            i += m.end()
        elif c == "`" or (c == "~" and i == 0 and quote is None):
            return None
        else:
            results = [r + c for r in results]
            i += 1
    if quote:
        return None
    return sorted(set(results))

def variable_lookup(pkgbuild, name, base):
    """lookup(var) for expand_word: the literal value(s) of a variable
    assigned exactly once, in a form that needs no evaluation. pkgname
    also allows the AUR package name, and every element of a split
    package's pkgname array (makepkg sets pkgname to each in turn).
    pkgbase also allows the AUR package base, and defaults to the first
    pkgname. Anything else is None (unresolved)."""
    texts = setter_texts(pkgbuild)
    no_vars = lambda var: None

    def assigned_values(var):
        hits = [(is_code, t) for is_code, t in texts if setter_re(var).search(t)]
        if len(hits) != 1:
            return None if hits else []
        is_code, hit = hits[0]
        if not is_code:
            return None
        v = re.escape(var)
        if re.match(rf"\s*{v}=\(", hit):
            # Array elements undergo brace expansion and may be indexed
            # ([0]=x), so only pkgname's documented plain-name subset is
            # accepted, and only when the whole declaration parses.
            if var != "pkgname":
                return None
            arr = re.fullmatch(rf"\s*{v}=\(([^()]*)\)\s*", hit)
            word = SHELL_WORD[:-1] + "+"
            if not arr or not re.fullmatch(rf"\s*(?:{word}\s+)*(?:{word})?\s*", arr.group(1)):
                return None
            values = [expand_word(w, no_vars) for w in re.findall(word, arr.group(1))]
            if any(val is None or len(val) != 1 for val in values):
                return None
            values = [val[0] for val in values]
        else:
            m = re.fullmatch(rf"\s*{v}=(?P<word>{SHELL_WORD})\s*", hit)
            values = expand_word(m.group("word"), no_vars) if m and "\n" not in hit else None
        if values is not None and var in ("pkgname", "pkgbase"):
            if not all(PKGNAME_CHARS_RE.match(val) for val in values):
                return None
        return values

    def lookup(var):
        values = assigned_values(var)
        if var == "pkgname":
            if values is None:
                return None
            return sorted(set(values) | {name})
        if var == "pkgbase":
            if values == []:
                names = assigned_values("pkgname")
                values = names[:1] if names else None
            if values is None:
                return None
            return sorted(set(values) | {base})
        return values or None

    return lookup

def install_targets(pkgbuild, name, base):
    """Install scripts the PKGBUILD may package, found statically without
    sourcing it. makepkg accepts any filename, so no suffix is assumed.
    Declarations anywhere in the file count, including every split
    package's - sibling packages share this repo and maintainer, so
    reading their scripts too is harmless extra coverage.

    Returns (declarations, unaccounted): declarations is a list of
    (raw_value, candidates) where candidates is a list of normalized
    relative paths the value may resolve to, or None if unresolved;
    unaccounted counts code lines that may set `install` in a form this
    function doesn't understand (e.g. `a=1; install=x`, `printf -v
    install`, a multi-line value, a heredoc line)."""
    lookup = variable_lookup(pkgbuild, name, base)
    setter = setter_re("install")
    declarations, unaccounted = [], 0
    for is_code, text in setter_texts(pkgbuild):
        if not setter.search(text):
            continue
        m = INSTALL_DECL_RE.fullmatch(text) if is_code and "\n" not in text else None
        if not m:
            unaccounted += 1
            continue
        word = m.group("word")
        values = expand_word(word, lookup)
        if values is not None:
            if not any(values):
                continue  # install= / install='' - explicitly no script
            values = sorted({posixpath.normpath(v) for v in values if v})
        declarations.append((word, values))
    return declarations, unaccounted

def srcinfo_install_targets(srcinfo):
    """install = <file> entries from .SRCINFO, which makepkg writes with
    values already expanded. The maintainer produces this file too, so it
    supplements the PKGBUILD's declarations and never replaces them."""
    found = re.findall(r"^\s*install\s*=\s*(.*?)\s*$", srcinfo, re.MULTILINE)
    return sorted({posixpath.normpath(v) for v in found if v})

def annotate_line(line):
    for pattern, note in LINE_ANNOTATIONS:
        if re.search(pattern, line):
            return note
    return None

def source_host(entry):
    # PKGBUILD source entries may use "renamed-file::url" syntax. Only treat
    # "::" as that separator if it appears BEFORE the URL's own "://" -
    # otherwise it's more likely bash substring syntax inside a variable
    # embedded in the URL itself, e.g. "${_realname::1}".
    scheme_idx = entry.find("://")
    prefix = entry[:scheme_idx] if scheme_idx != -1 else entry
    sep = prefix.rfind("::")
    url = entry[sep + 2:] if sep != -1 else entry
    unresolved = "origin can't be statically resolved (built from a variable) - check how that variable is defined"
    try:
        parsed = urllib.parse.urlparse(url)
        netloc = parsed.netloc
    except ValueError:
        # e.g. "https://[${_ipv6}]/..." - Python rejects a bracketed host
        # that isn't a literal IPv6 address.
        if "$" in url:
            return None, unresolved
        return None, "malformed URL - read this source entry yourself"
    if "$" in netloc:
        return None, unresolved
    if not netloc:
        if "$" in url:
            return None, unresolved
        return None, "local file bundled with the package (no download)"
    label = "known code-hosting site" if netloc in KNOWN_HOSTS else "unrecognized host - worth a manual glance"
    return netloc, label

def print_explain_report(name, info, pkgbuild, base=None):
    base = base or name
    if not info:
        print(f"'{name}' wasn't found on the AUR.")
        return
    if not pkgbuild:
        print(f"Found '{name}' on the AUR, but couldn't fetch its PKGBUILD.")
        return

    print(f"=== {sanitize(name)} - what this package is ===")
    print(f"  {sanitize(info.get('Description', '(no description)'))}")
    print(f"  version: {sanitize(info.get('Version', '?'))}   maintainer: {sanitize(info.get('Maintainer')) or 'none (orphaned)'}")
    print(f"  upstream: {sanitize(info.get('URL', '?'))}")
    print(f"  votes: {info.get('NumVotes', 0)}   popularity: {info.get('Popularity', 0.0):.2f}")

    print("\n=== dependencies ===")
    for label, var in (("runtime (depends)", "depends"), ("build-time only (makedepends)", "makedepends"),
                        ("optional (optdepends)", "optdepends")):
        items = [sanitize(i) for i in extract_array(pkgbuild, var)]
        if items:
            print(f"  {label}: {', '.join(items)}")

    print("\n=== where the source comes from ===")
    sources = extract_array(pkgbuild, "source")
    if not sources:
        print("  no source=() array found (unusual - read the PKGBUILD directly)")
    for entry in sources:
        entry = sanitize(entry)
        host, label = source_host(entry)
        if host:
            print(f"  {entry}\n    -> {host} ({label})")
        else:
            print(f"  {entry}\n    -> {label}")

    print("\n=== what the build actually does ===")
    any_function = False
    # The order makepkg runs them in.
    for func in ("verify", "prepare", "pkgver", "build", "check", "package"):
        body, complete = extract_function(pkgbuild, func)
        # Split packages (pkgname=(a b ...)) define package_<name>() per
        # subpackage instead of one shared package() - fall back to that so
        # --explain on a split package doesn't wrongly report "no package()".
        if body is None and func == "package":
            split_func = f"package_{name}"
            body, complete = extract_function(pkgbuild, split_func)
            if body is not None:
                func = split_func
        if body is None:
            continue
        any_function = True
        print(f"\n  {func}() {{")
        if not complete:
            print("    !! couldn't find where this function ends - everything after its start is shown,")
            print("       and the walkthrough may be wrong. Read this part of the PKGBUILD directly.")
        for raw_line in body.splitlines():
            line = sanitize(raw_line.strip())
            if not line or line.startswith("#"):
                continue
            note = annotate_line(line)
            if note:
                print(f"    {line}")
                print(f"        ^ {note}")
            else:
                print(f"    {line}")
                print(f"        ^ (not a pattern this script recognizes - worth reading yourself)")
        print("  }")
    if not any_function:
        print("  no verify()/prepare()/pkgver()/build()/check()/package() functions found - "
              "unusual for a normal PKGBUILD")

    flags = scan_pkgbuild(pkgbuild)
    print("\n=== automated red-flag scan ===")
    if flags:
        for f in flags:
            count_suffix = f" [x{f['count']}]" if f.get("count", 1) > 1 else ""
            print(f"  ! {f['desc']}{count_suffix} (line {f['line_no']}): {f['line']}")
    else:
        print("  none of this script's known-bad patterns matched")

    declarations, unaccounted = install_targets(pkgbuild, name, base)
    for raw, cands in declarations:
        if cands is None:
            print(f"\n  !! sets install={sanitize(raw)} - a root-run install script whose name "
                  f"can't be resolved statically; read the PKGBUILD to see which file that is")
            continue
        print(f"\n  !! sets install={sanitize(raw)} - that file can run code as ROOT at install/"
              f"upgrade time, which --explain does not read. Fetch and read it yourself:")
        for target in cands:
            print(f"     https://aur.archlinux.org/cgit/aur.git/plain/"
                  f"{urllib.parse.quote(target)}?h={urllib.parse.quote(base)}")
    if unaccounted:
        print(f"\n  !! {unaccounted} line(s) may set install= in a form this scan can't follow - "
              f"search the PKGBUILD for 'install' and check each one yourself")

    print(PKGBUILD_PRIMER)

PKGBUILD_PRIMER = """
=== PKGBUILD anatomy, quick primer ===
A PKGBUILD is a bash script, not a config file - everything in it is code
that runs. Reading order that actually matters:
  1. source=()      what gets downloaded, and from where. This is the
                     single most important line for trust - a package
                     pulling from a domain you don't recognize deserves
                     more scrutiny than one pulling from the project's own
                     GitHub.
  2. sha256sums=() / b2sums=()   checksums that pin the exact bytes of each
                     source= entry. makepkg refuses to build if they don't
                     match - this is what stops a compromised upstream
                     server from silently swapping the tarball later.
  3. prepare()      optional: patches/fixes applied to the source before
                     building.
  4. build()        compiles the software. For most packages this is just
                     the project's normal build commands (make, cmake,
                     cargo build, ...) - nothing package-specific should
                     need to happen here beyond that.
  5. package()      THIS is the one that matters most for "what ends up on
                     my system" - it copies build output into $pkgdir,
                     which becomes the actual installed package. Anything
                     install -Dm... $pkgdir/... here is a real file that
                     lands on your machine.
$srcdir = where the source got extracted to (scratch space, thrown away
after build). $pkgdir = the staging root for what actually gets installed
- treat any line touching $pkgdir as the one to read most carefully.
"""

def install_coverage_flags(name, declarations, unaccounted, srcinfo_targets, aux_files):
    """Findings for every install script that wasn't confirmed read. An
    install script runs as ROOT at install/upgrade time, so an unread one
    must never pass silently.

    A declaration with several possible values is covered when at least one
    was read and none was refused: a candidate that simply doesn't exist is
    a hypothetical alternative (makepkg can't package a missing file), but
    one that exists and was refused (symlink, too large, ...) may be the
    real script. aux_files is None when no file could be read at all."""
    status = aux_files.status if aux_files is not None else (lambda path: "the package repo wasn't read")
    unread = {}
    for raw, cands in declarations:
        if cands is None:
            unread.setdefault(raw, "its value can't be resolved statically")
            continue
        statuses = {c: status(c) for c in cands}
        refused = {c: s for c, s in statuses.items() if s not in (None, MISSING)}
        for c, s in refused.items():
            unread.setdefault(c, s)
        if not refused and all(s is not None for s in statuses.values()):
            target = cands[0] if len(cands) == 1 else raw
            reason = statuses[cands[0]] if len(cands) == 1 else MISSING
            unread.setdefault(target, reason)
    for target in srcinfo_targets:
        s = status(target)
        if s is not None:
            unread.setdefault(target, f"{s} (declared in .SRCINFO)")

    flags = [{
        "desc": f"sets install={sanitize(target)} - that file can run code as ROOT at "
                f"install/upgrade time, and this scan could not read it: {reason} "
                f"(see: auracular --explain {name})",
        "penalty": 10, "line_no": 0, "line": "", "count": 1, "source": "PKGBUILD",
    } for target, reason in unread.items()]
    if unaccounted:
        flags.append({
            "desc": f"may set install= in {unaccounted} place(s) this scan can't follow - a "
                    f"root-run install script may have gone unread (see: auracular --explain {name})",
            "penalty": 10, "line_no": 0, "line": "", "count": 1, "source": "PKGBUILD",
        })
    return flags

def headline_reason(notes, max_len=58):
    non_baseline = [n for n in notes if not n.startswith("baseline:")]
    if not non_baseline:
        return "no red flags, but no strong positive signals either"
    text = "; ".join(non_baseline)
    if len(text) <= max_len:
        return text
    cut = text.rfind(" ", 0, max_len - 3)
    cut = cut if cut > 0 else max_len - 3
    return text[:cut] + "... (see below)"

def bucket(score):
    if score >= 75:
        return "LOW RISK"
    if score >= 50:
        return "REVIEW"
    if score >= 25:
        return "CAUTION"
    return "HIGH RISK"

# icon, ANSI color code per bucket. Kept to single-width, non-emoji-presentation
# glyphs so table columns stay aligned across terminals/fonts.
RISK_STYLE = {
    "LOW RISK":  ("✓", "\033[92m"),  # check mark, green
    "REVIEW":    ("?",      "\033[96m"),  # cyan
    "CAUTION":   ("⚠", "\033[93m"),  # warning sign, yellow
    "HIGH RISK": ("☠", "\033[91m"),  # skull, red
}

def color_wrap(text, color_code):
    # Pad/measure `text` BEFORE calling this - wrapping happens after padding
    # so escape codes never throw off column alignment.
    if not use_color():
        return text
    return f"{color_code}{text}\033[0m"

def styled_bucket_field(score, width):
    label = bucket(score)
    icon, color_code = RISK_STYLE[label]
    padded = f"{icon} {label}".ljust(width)
    return color_wrap(padded, color_code)

def styled_score_field(score, width):
    color_code = RISK_STYLE[bucket(score)][1]
    padded = f"{score}".rjust(width)
    return color_wrap(padded, color_code)

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("packages", nargs="*", help="AUR package names to check")
    ap.add_argument("--installed", action="store_true", help="check every foreign/AUR package currently installed")
    ap.add_argument("-v", "--verbose", action="store_true", help="show matched PKGBUILD lines")
    ap.add_argument("--no-history", action="store_true",
                     help="skip the git-history maintainer-handoff check (faster, but misses takeover detection)")
    ap.add_argument("--explain", metavar="PKG",
                     help="print a plain-English, annotated PKGBUILD walkthrough for one package")
    args = ap.parse_args()

    print_banner()

    if args.explain:
        explain_info = fetch_aur_info([args.explain])
        if explain_info is None:
            print("Couldn't reach the AUR RPC endpoint - try again in a moment.", file=sys.stderr)
            sys.exit(1)
        info = explain_info.get(args.explain)
        base = info.get("PackageBase") or args.explain if info else args.explain
        pkgbuild = fetch_pkgbuild(base) if info else None
        if pkgbuild and not looks_like_pkgbuild(pkgbuild):
            print(f"  ! fetched content doesn't look like a PKGBUILD (error/challenge page?)", file=sys.stderr)
            pkgbuild = None
        print_explain_report(args.explain, info, pkgbuild, base=base)
        return

    names = list(args.packages)
    if args.installed or not names:
        if not names:
            print("No packages given - defaulting to every installed AUR package (--installed).", file=sys.stderr)
        names += installed_foreign_packages()
    names = sorted(set(names))

    if not names:
        print("No foreign (AUR) packages are currently installed.", file=sys.stderr)
        sys.exit(0)

    print(f"Looking up {len(names)} package(s) on AUR...", file=sys.stderr)
    aur_info = fetch_aur_info(names)
    if aur_info is None:
        print("Couldn't reach the AUR RPC endpoint - no scores can be produced right now. "
              "Try again in a moment.", file=sys.stderr)
        sys.exit(1)
    official_names = official_repo_names()

    results = []
    for name in names:
        info = aur_info.get(name)
        # AUR keys split packages (e.g. "gcc11-libs") by a separate PackageBase
        # field ("gcc11") - the PKGBUILD and git repo live under the base name,
        # not the package name, and fetching by `name` alone 404s silently.
        base = (info.get("PackageBase") or name) if info else name

        pkgbuild = fetch_pkgbuild(base) if info else None
        if pkgbuild and not looks_like_pkgbuild(pkgbuild):
            print(f"  ! fetched content for {name} doesn't look like a PKGBUILD "
                  f"(error/challenge page?) - treating it as unscanned", file=sys.stderr)
            pkgbuild = None
        # None = never fetched/scanned (stays None all the way to score_package,
        # which must not treat that as "scanned clean"); [] = scanned, no hits.
        pkgbuild_flags = scan_pkgbuild(pkgbuild) if pkgbuild else (None if info else [])

        declarations, unaccounted = install_targets(pkgbuild, name, base) if pkgbuild else ([], 0)
        wanted = sorted({c for _, cands in declarations for c in (cands or [])})

        tsquat = typosquat_check(name, official_names)

        handoff = None
        history_unavailable = False
        aux_flags = []
        aux_files = None
        srcinfo_targets = []
        if info and not args.no_history:
            print(f"  checking commit history for {name}...", file=sys.stderr)
            commits, aux_files = fetch_commit_history(base, extra_files=wanted)
            if commits is None:
                history_unavailable = True
            else:
                handoff = analyze_maintainer_history(commits)
            if aux_files is not None:
                srcinfo = aux_files.pop(SRCINFO, None)
                srcinfo_targets = srcinfo_install_targets(srcinfo) if srcinfo else []
            for fname, body in (aux_files or {}).items():
                for f in scan_pkgbuild(body, source_label=fname):
                    f["penalty"] = int(f["penalty"] * 1.5)  # runs as root at install time
                    aux_flags.append(f)
        aux_skipped = aux_files is None

        coverage_flags = install_coverage_flags(name, declarations, unaccounted,
                                                srcinfo_targets, aux_files)

        score, notes = score_package(name, info, pkgbuild_flags, tsquat, handoff=handoff,
                                      history_unavailable=history_unavailable,
                                      aux_flags=aux_flags, coverage_flags=coverage_flags,
                                      verbose=args.verbose)
        if info and args.no_history:
            notes.append("commit history check skipped (--no-history) - maintainer-handoff "
                          "detection AND auxiliary/.install file scanning did not run")
        elif info and aux_skipped:
            notes.append("auxiliary/.install file scanning did not run (commit history was unavailable)")
        if base != name:
            notes.insert(0, f"part of split package base '{base}' - PKGBUILD/history read from there")
        results.append((name, score, notes))

    results.sort(key=lambda r: r[1])  # riskiest first

    print()
    print(f"{'PACKAGE':<24}{'SCORE':>6}  {'RISK':<12}WHY")
    print("-" * 90)
    for name, score, notes in results:
        print(f"{name:<24}{styled_score_field(score, 6)}  {styled_bucket_field(score, 12)}{headline_reason(notes)}")

    print()
    print("Details (riskiest first):")
    for name, score, notes in results:
        if not notes:
            continue
        print(f"\n{name} [{score}/100, {styled_bucket_field(score, 0)}]")
        for n in notes:
            print(f"  - {n}")

if __name__ == "__main__":
    main()
