def http_get(url, timeout=8):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", errors="replace")

def fetch_aur_info(names):
    """Returns {name: info}, or None if the RPC lookup itself failed (network,
    timeout, bad response, or the RPC's own error shape) - callers must not
    treat None the same as {} (a lookup that succeeded and found nothing).
    aurweb can return HTTP 200 with valid JSON that is still an error
    (`{"type": "error", ...}`, or in principle `null`) - treating that as
    "queried successfully, found nothing" would silently report every
    requested package as HIGH RISK "not found on AUR" during an outage."""
    if not names:
        return {}
    qs = "&".join("arg[]=" + urllib.parse.quote(n) for n in names)
    url = f"{AUR_RPC}?{qs}"
    try:
        data = json.loads(http_get(url))
    except Exception as e:
        print(f"  ! AUR RPC lookup failed: {e}", file=sys.stderr)
        return None
    if not isinstance(data, dict) or data.get("type") != "multiinfo":
        err = data.get("error") if isinstance(data, dict) else "unexpected response shape"
        print(f"  ! AUR RPC returned an unexpected/error response: {err}", file=sys.stderr)
        return None
    results = data.get("results")
    if not isinstance(results, list) or not all(valid_rpc_row(r) for r in results):
        print("  ! AUR RPC response had a malformed 'results' field", file=sys.stderr)
        return None
    return {r["Name"]: r for r in results}

# Latest timestamp datetime.fromtimestamp() can represent (end of year 9999).
MAX_TIMESTAMP = 253402300799

MAX_RPC_NUMBER = 1e12

def valid_rpc_row(row):
    """Every field scoring relies on has the type scoring expects. One bad
    row fails the whole lookup: silently dropping it would turn that
    package into a misleading "not found on AUR". A field may be absent
    (scoring has a default), but only fields scoring treats as optional
    may be explicitly null."""
    def is_num(v):
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            return False
        try:
            return math.isfinite(float(v)) and 0 <= v <= MAX_RPC_NUMBER
        except OverflowError:
            return False

    def is_ts(v):
        return isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= MAX_TIMESTAMP

    def is_str(v):
        return isinstance(v, str)

    if not isinstance(row, dict) or not isinstance(row.get("Name"), str) or not row["Name"]:
        return False
    # field: (check, may be null)
    checks = {
        "NumVotes": (is_num, False), "Popularity": (is_num, False),
        "FirstSubmitted": (is_ts, True), "OutOfDate": (is_ts, True),
        "Maintainer": (is_str, True), "PackageBase": (is_str, True),
    }
    for key, (check, nullable) in checks.items():
        if key not in row or (row[key] is None and nullable):
            continue
        if not check(row[key]):
            return False
    return True

def fetch_pkgbuild(name):
    try:
        return http_get(PKGBUILD_URL.format(pkg=urllib.parse.quote(name)))
    except Exception as e:
        print(f"  ! couldn't fetch PKGBUILD for {name}: {e}", file=sys.stderr)
        return None

def looks_like_pkgbuild(text):
    """A 200 OK response carrying an HTML error/challenge page (rate-limit,
    WAF, anti-bot interstitial, ...) is not an exception - http_get returns
    it as ordinary text, and scanning it finds no suspicious patterns
    because it isn't shell code at all. Without this check that reads as
    "scanned, clean" instead of "not actually read"."""
    if not text:
        return False
    head = text[:2000]
    if re.search(r"<!doctype html|<html[\s>]", head, re.IGNORECASE):
        return False
    return bool(re.search(r"^\s*pkgname\s*=", text, re.MULTILINE))

def installed_foreign_packages():
    try:
        out = subprocess.run(["pacman", "-Qmq"], capture_output=True, text=True, check=True).stdout
    except Exception as e:
        print(f"Couldn't run pacman -Qmq: {e}", file=sys.stderr)
        return []
    return [l.strip() for l in out.splitlines() if l.strip()]

def official_repo_names():
    try:
        out = subprocess.run(["pacman", "-Slq"], capture_output=True, text=True, check=True).stdout
        return set(l.strip() for l in out.splitlines() if l.strip())
    except Exception:
        return set()

# --- static shell lexing -------------------------------------------------
# One pass shared by the red-flag scan, install-script discovery, and the
# explainer's function extraction. It never executes anything: it only
# tracks enough bash syntax (quotes, escapes, comments, line continuations,
# command/process substitutions, heredocs) to know which text is code,
# which is data, and where commands and { } groups begin and end.

CONTINUATION_OPERATORS = ("|", "&&", "||", "|&")
SHELL_OPERATORS = ("<<<", "<<-", ";;&", "&>>", "&&", "||", ";;", ";&", "|&", "&>", ">>",
                   "<<", "<&", ">&", "<>", ">|", ";", "&", "|", "(", ")", "<", ">")
SEPARATOR_OPERATORS = {"&&", "||", ";;&", ";;", ";&", "|&", ";", "&", "|", "(", ")"}
WORD_BREAK_CHARS = set(" \t\n;&|<>()")
# Reserved words after which the next word is still a command.
COMMAND_PREFIX_WORDS = {"{", "!", "if", "then", "else", "elif", "do", "while", "until", "time"}
ASSIGNMENT_WORD_RE = re.compile(r"[A-Za-z_]\w*(?:\[[^\]]*\])?\+?=")

class ShellLex:
    """Result of lex_shell(): statements are (line_no, text) for each
    logical command line with comments removed and continuations joined;
    heredoc_lines are (line_no, text) for each here-document body line
    (data that may still be expanded or fed to a shell); words are
    (start, end, raw, command_position) for top-level words; complete is
    False if the text ended inside a quote, substitution, or heredoc."""

    def __init__(self, text):
        self.text = text
        self.pos = 0
        self.statements = []
        self.heredoc_lines = []
        self.words = []
        self.complete = True
        self._pending_heredocs = []
        self._line_starts = [0] + [m.end() for m in re.finditer("\n", text)]

    def line_no(self, offset):
        return bisect.bisect_right(self._line_starts, offset)

    def _at(self, s, offset=0):
        return self.text.startswith(s, self.pos + offset)

    def _operator(self):
        for op in SHELL_OPERATORS:
            if self._at(op):
                self.pos += len(op)
                return op
        return None

    def _single_quote(self):
        end = self.text.find("'", self.pos + 1)
        if end == -1:
            self.complete = False
            end = len(self.text) - 1
        raw = self.text[self.pos:end + 1]
        self.pos = end + 1
        return raw

    def _ansi_c_quote(self):
        start = self.pos
        self.pos += 2
        while self.pos < len(self.text):
            c = self.text[self.pos]
            if c == "\\":
                self.pos += 2
                continue
            self.pos += 1
            if c == "'":
                return self.text[start:self.pos]
        self.complete = False
        return self.text[start:]

    def _backtick(self):
        start = self.pos
        self.pos += 1
        while self.pos < len(self.text):
            c = self.text[self.pos]
            if c == "\\":
                self.pos += 2
                continue
            self.pos += 1
            if c == "`":
                return self.text[start:self.pos]
        self.complete = False
        return self.text[start:]

    def _braced_parameter(self):
        start = self.pos
        self.pos += 2
        depth = 1
        while self.pos < len(self.text) and depth:
            c = self.text[self.pos]
            if c == "\\":
                self.pos += 2
            elif c == "'":
                self._single_quote()
            elif c == '"':
                self._double_quote()
            elif self._at("${"):
                depth += 1
                self.pos += 2
            elif self._at("$("):
                self.pos += 2
                self._code(nested=True)
            else:
                depth -= c == "}"
                self.pos += 1
        if depth:
            self.complete = False
        return self.text[start:self.pos]

    def _double_quote(self):
        out = ['"']
        self.pos += 1
        while self.pos < len(self.text):
            c = self.text[self.pos]
            if c == '"':
                self.pos += 1
                out.append('"')
                return "".join(out)
            if c == "\\":
                if not self._at("\n", 1):
                    out.append(self.text[self.pos:self.pos + 2])
                self.pos += 2
            elif self._at("$("):
                self.pos += 2
                out.append("$(" + self._code(nested=True) + ")")
            elif self._at("${"):
                out.append(self._braced_parameter())
            elif c == "`":
                out.append(self._backtick())
            else:
                out.append(c)
                self.pos += 1
        self.complete = False
        return "".join(out)

    def _word(self):
        out = []
        while self.pos < len(self.text):
            c = self.text[self.pos]
            if c == "(" and out and out[-1].endswith("="):
                # array assignment: name=( ... )
                self.pos += 1
                out.append("(" + self._code(nested=True) + ")")
            elif c in WORD_BREAK_CHARS:
                break
            elif c == "\\":
                if not self._at("\n", 1):
                    out.append(self.text[self.pos:self.pos + 2])
                self.pos += 2
            elif c == "'":
                out.append(self._single_quote())
            elif c == '"':
                out.append(self._double_quote())
            elif c == "`":
                out.append(self._backtick())
            elif self._at("$("):
                self.pos += 2
                out.append("$(" + self._code(nested=True) + ")")
            elif self._at("${"):
                out.append(self._braced_parameter())
            elif self._at("$'"):
                out.append(self._ansi_c_quote())
            else:
                out.append(c)
                self.pos += 1
        return "".join(out)

    def _heredoc_operator(self, op):
        start = self.pos
        while self._at(" ") or self._at("\t"):
            self.pos += 1
        raw = self._word()
        delimiter = re.sub(r"""['"\\]""", "", raw)
        if not delimiter:
            self.complete = False
        self._pending_heredocs.append((delimiter, op == "<<-"))
        return self.text[start:self.pos]

    def _heredoc_bodies(self):
        pending, self._pending_heredocs = self._pending_heredocs, []
        for delimiter, strip_tabs in pending:
            while True:
                if self.pos >= len(self.text):
                    self.complete = False
                    break
                line_start = self.pos
                nl = self.text.find("\n", self.pos)
                end = len(self.text) if nl == -1 else nl
                line = self.text[line_start:end]
                self.pos = end + 1
                if (line.lstrip("\t") if strip_tabs else line) == delimiter:
                    break
                self.heredoc_lines.append((self.line_no(line_start), line))

    def _emit(self, start, buf):
        text = "".join(buf)
        if text.strip():
            self.statements.append((self.line_no(start), text))

    def _code(self, nested=False):
        """Lex code to the end of the text, or (nested) up to and including
        the `)` that closes a substitution or array, returning the
        processed text in between."""
        buf, start = [], None
        command_position, redirect_target, function_name_next = True, False, False
        depth = 0
        while self.pos < len(self.text):
            c = self.text[self.pos]
            if c == "\n":
                self.pos += 1
                self._heredoc_bodies()
                if nested:
                    buf.append("\n")
                    command_position = True
                elif "".join(buf).rstrip().endswith(CONTINUATION_OPERATORS):
                    buf.append(" ")
                else:
                    self._emit(start, buf)
                    buf, start, command_position = [], None, True
                continue
            if c in " \t":
                buf.append(c)
                self.pos += 1
                continue
            if c == "\\" and self._at("\n", 1):
                self.pos += 2
                continue
            if c == "#":
                nl = self.text.find("\n", self.pos)
                self.pos = len(self.text) if nl == -1 else nl
                continue
            if start is None:
                start = self.pos
            op = self._operator()
            if op:
                if nested and op == "(":
                    depth += 1
                elif nested and op == ")":
                    if depth == 0:
                        return "".join(buf)
                    depth -= 1
                buf.append(op)
                if op in ("<<", "<<-"):
                    buf.append(self._heredoc_operator(op))
                elif op in ("<", ">") and self._at("("):
                    self.pos += 1
                    buf.append("(" + self._code(nested=True) + ")")
                elif op in SEPARATOR_OPERATORS:
                    command_position = True
                else:
                    redirect_target = True
                continue
            word_start = self.pos
            raw = self._word()
            buf.append(raw)
            if not nested:
                self.words.append((word_start, self.pos, raw, command_position and not redirect_target))
            if redirect_target:
                redirect_target = False
            elif function_name_next:
                function_name_next = False
                command_position = True
            elif command_position:
                if raw == "function":
                    function_name_next = True
                    command_position = False
                elif raw not in COMMAND_PREFIX_WORDS and not ASSIGNMENT_WORD_RE.match(raw):
                    command_position = False
        if nested:
            self.complete = False
            return "".join(buf)
        self._emit(start, buf)
        return None

@functools.lru_cache(maxsize=64)
def lex_shell(text):
    lex = ShellLex(text)
    lex._code()
    return lex

def logical_lines(text):
    """(line_no, text) for every logical command line (comments removed,
    backslash and |/&&/|| continuations joined, quoted text kept since it
    is often passed to eval or sh -c) and every heredoc body line, in
    source order. A line that merely starts with # inside a quoted string
    or heredoc is not a comment and is kept."""
    lex = lex_shell(text)
    return sorted(lex.statements + lex.heredoc_lines, key=lambda item: item[0])

def scan_pkgbuild(text, source_label="PKGBUILD"):
    """Charges each matching pattern once (with a count of how many lines it
    hit), not once per line - a package repeating the same flagged line
    several times shouldn't stack an unbounded, hard-to-read penalty."""
    flags = []
    if not text:
        return flags
    lines = [(n, re.sub(r"[ \t]+", " ", l)) for n, l in logical_lines(text)]
    for pattern, desc, penalty in SUSPICIOUS_PATTERNS:
        hits = []
        for n, l in lines:
            m = re.search(pattern, l, re.IGNORECASE)
            if m:
                hits.append((n + l.count("\n", 0, m.start()), l))
        if hits:
            line_no, line = hits[0]
            flags.append({
                "desc": desc, "penalty": penalty, "line_no": line_no,
                "line": sanitize(" ".join(line.split())), "count": len(hits),
                "source": sanitize(source_label),
            })
    if not lex_shell(text).complete:
        flags.append({
            "desc": "couldn't be fully parsed (unterminated quote, substitution, or heredoc) - "
                    "findings for it may be incomplete",
            "penalty": 10, "line_no": 0, "line": "", "count": 1, "source": sanitize(source_label),
        })
    return flags

MAX_AUX_FILE_BYTES = 1_000_000

MISSING = "no such file in the package repo"

def read_contained_file(root, path):
    """(contents, None) if `path` is a regular, non-symlink file of sane size
    fully inside `root`, else (None, reason). reason is MISSING when nothing
    exists there, otherwise why an existing path was refused. A malicious
    package's repo could commit a symlink (e.g. "pwn.install" ->
    "/home/you/.ssh/id_rsa") or a "../"-style path to trick this scanner
    into reading and displaying an arbitrary local file."""
    try:
        if path.is_symlink():
            return None, "refused: it is a symlink"
        resolved = path.resolve()
        try:
            resolved.relative_to(root)
        except ValueError:
            return None, "refused: it points outside the package repo"
        if not resolved.exists():
            return None, MISSING
        if not resolved.is_file():
            return None, "refused: not a regular file"
        if resolved.stat().st_size > MAX_AUX_FILE_BYTES:
            return None, "refused: larger than the 1MB read limit"
        return resolved.read_text(errors="replace"), None
    except OSError as e:
        return None, f"refused: read error ({e.strerror or e.__class__.__name__})"

class AuxFiles(dict):
    """{relative_path: contents} of files read from a package clone, plus
    `skipped`: {relative_path: reason} for every requested or discovered
    path that was not read, so "absent from this dict" is never ambiguous."""

    def __init__(self):
        super().__init__()
        self.skipped = {}

    def status(self, path):
        """None if `path` was read, else the reason it wasn't."""
        return None if path in self else self.skipped.get(path, MISSING)

def parse_git_log(output):
    """Parse NUL-separated `%ae%x00%an%x00%at` records. Returns (commits,
    complete). Author names are chosen by whoever commits, so a delimiter
    that can legally appear in a name (like "|") would let a committer
    corrupt or hide their own record; NUL can't appear in either field.
    complete is False if any record was still malformed, so callers can
    report the history as unreliable instead of silently analyzing a
    subset of it."""
    commits, complete = [], True
    for line in output.splitlines():
        parts = line.split("\x00")
        if len(parts) != 3:
            complete = False
            continue
        email, author_name, ts = parts
        try:
            commits.append((email.strip().lower(), author_name.strip(), int(ts)))
        except ValueError:
            complete = False
    return commits, complete

def fetch_commit_history(name, extra_files=(), timeout=15):
    """Clone the package's AUR git repo and return (commits, aux_files).

    commits is a list of (email, author_name, unix_ts) per commit, oldest
    first, or None if the history couldn't be read completely - callers
    should treat None as "history unavailable", not "clean".

    aux_files is an AuxFiles {relative_path: contents} for any .install/
    .hook/.service/.timer files, plus any `extra_files` (relative paths,
    e.g. an install script named by `install=` without a .install suffix),
    plus the .SRCINFO file under the key SRCINFO along with any install
    scripts it declares; its `skipped` records why every other requested
    or discovered path wasn't read. .SRCINFO is metadata, not code: callers
    should pop it before scanning. aux_files is None if the clone itself
    failed or errored before any file could be read.

    AUR packages are tiny repos (PKGBUILD + maybe an .install file), so a
    full clone is cheap."""
    tmpdir = tempfile.mkdtemp(prefix="aurtc-")
    try:
        url = AUR_GIT_URL.format(pkg=urllib.parse.quote(name))
        r = subprocess.run(["git", "clone", "--quiet", url, tmpdir],
                            capture_output=True, text=True, timeout=timeout)
        if r.returncode != 0:
            return None, None
        root = pathlib.Path(tmpdir).resolve()

        commits = None
        try:
            r2 = subprocess.run(["git", "-C", tmpdir, "log", "--reverse", "--format=%ae%x00%an%x00%at"],
                                 capture_output=True, text=True, timeout=timeout)
        except (subprocess.SubprocessError, OSError):
            r2 = None
        if r2 is not None and r2.returncode == 0:
            parsed, complete = parse_git_log(r2.stdout)
            if complete:
                commits = parsed

        aux_files = AuxFiles()
        srcinfo, _ = read_contained_file(root, root / SRCINFO)
        if srcinfo is not None:
            aux_files[SRCINFO] = srcinfo
            extra_files = [*extra_files, *srcinfo_install_targets(srcinfo)]

        candidates = [(str(p.relative_to(root)), p) for pattern in AUX_GLOBS for p in root.rglob(pattern)]
        candidates += [(rel, root / rel) for rel in extra_files]
        for key, p in candidates:
            if key in aux_files or key in aux_files.skipped:
                continue
            if not p.is_relative_to(root):
                aux_files.skipped[key] = "refused: it points outside the package repo"
                continue
            body, reason = read_contained_file(root, p)
            if body is not None:
                aux_files[key] = body
            else:
                aux_files.skipped[key] = reason
        return commits, aux_files
    except Exception:
        return None, None
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

# Domains shared by unrelated strangers (free mail providers, GitHub's
# per-user noreply domain, ...) - matching on these alone says nothing about
# whether two commits came from the same person. A private/company domain
# match is real evidence; a match on one of these needs corroboration too.
GENERIC_EMAIL_DOMAINS = {
    "gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "live.com",
    "yahoo.com", "proton.me", "protonmail.com", "pm.me", "icloud.com", "me.com",
    "fastmail.com", "users.noreply.github.com", "posteo.de", "tutanota.com",
    "mailbox.org", "web.de", "gmx.de", "gmx.net", "t-online.de", "qq.com", "163.com",
}

def identity_similar(a, b):
    """a, b are (email, name). True if they plausibly belong to the same
    person despite a cosmetic git-config change (same email, a matching
    non-generic domain, a matching local-part on a generic domain, or a
    close name match) - same person switching machines is common and
    shouldn't read as a handoff. A shared *generic* domain (gmail.com,
    users.noreply.github.com, ...) is NOT enough on its own: unrelated
    people share those constantly, and treating it as a match would mask a
    real handoff between two different Gmail users."""
    email_a, name_a = a
    email_b, name_b = b
    if email_a == email_b:
        return True
    local_a, _, domain_a = email_a.partition("@")
    local_b, _, domain_b = email_b.partition("@")
    if domain_a and domain_a == domain_b:
        if domain_a not in GENERIC_EMAIL_DOMAINS:
            return True
        if difflib.SequenceMatcher(None, local_a, local_b).ratio() > 0.8:
            return True
    return difflib.SequenceMatcher(None, name_a.lower(), name_b.lower()).ratio() > 0.75

def analyze_maintainer_history(commits):
    """Group commits into maintainer 'eras' (runs of similar identities) and
    check whether ANY era boundary shows a long dormancy gap - the shape of
    a dormant package getting quietly taken over, not routine
    co-maintenance. Looking only at the last two eras (eras[-2] vs eras[-1])
    would let a single follow-up commit under a third identity push the
    actual takeover out of view, erasing the detection - so every boundary
    is checked and the most recent qualifying one wins. Returns a dict
    describing the handoff, or None if there isn't one / there's not enough
    history to tell / a qualifying handoff is old and long-settled."""
    if not commits or len(commits) < 2:
        return None

    eras = []
    for email, author_name, ts in commits:
        identity = (email, author_name)
        if eras and any(identity_similar(identity, i) for i in eras[-1]["identities"]):
            eras[-1]["identities"].add(identity)
            eras[-1]["end_ts"] = ts
            eras[-1]["count"] += 1
        else:
            eras.append({
                "identities": {identity}, "start_ts": ts, "end_ts": ts,
                "count": 1, "first_identity": identity,
            })

    if len(eras) < 2:
        return None

    boundaries = [
        (i, (eras[i + 1]["start_ts"] - eras[i]["end_ts"]) / 86400)
        for i in range(len(eras) - 1)
    ]
    qualifying = [(i, gap) for i, gap in boundaries if gap >= DORMANCY_THRESHOLD_DAYS]
    if not qualifying:
        return None

    idx, gap_days = qualifying[-1]
    latest_era = eras[idx + 1]
    commits_since = sum(e["count"] for e in eras[idx + 1:])

    now_ts = datetime.now(timezone.utc).timestamp()
    since_takeover_days = (now_ts - latest_era["start_ts"]) / 86400

    # A handoff that happened years ago, with the new maintainer having put
    # in real work since, isn't a live signal - it's history. Reporting it
    # forever just crowds out packages with an actual recent, thin handoff.
    if since_takeover_days > 730 and commits_since > 5:
        return None

    new_identity_name = sanitize(latest_era["first_identity"][1])

    return {
        "gap_days": int(gap_days),
        "commits_since": commits_since,
        "since_takeover_days": int(since_takeover_days),
        "new_identity_name": new_identity_name,
    }

def typosquat_check(name, official_names):
    if name in official_names or not official_names:
        return None
    close = difflib.get_close_matches(name, official_names, n=1, cutoff=0.85)
    if close and close[0] != name:
        return close[0]
    return None

def score_package(name, info, pkgbuild_flags, typosquat_target, handoff=None,
                   history_unavailable=False, aux_flags=None, coverage_flags=None, verbose=False):
    """pkgbuild_flags is None when the PKGBUILD could not be fetched/scanned
    at all (distinct from an empty list, which means it WAS scanned and
    nothing matched) - callers must pass None rather than [] in that case,
    or an unscanned package silently reads as "clean". aux_flags (findings
    from .install/.hook/etc files) is kept as a SEPARATE parameter rather
    than merged into pkgbuild_flags before calling this: merging them would
    turn a None (PKGBUILD unscanned) into a non-None list the moment any
    aux finding exists, silently erasing the "PKGBUILD was never read"
    warning even though the PKGBUILD itself - the primary thing this tool
    is supposed to check - still wasn't. coverage_flags (e.g. an install
    script that couldn't be read) is separate for the same reason."""
    score = 70  # neutral baseline
    notes = []

    if info is None:
        return 0, ["not found on AUR (may have been removed, or you mistyped the name)"]

    votes = info.get("NumVotes", 0)
    pop = info.get("Popularity", 0.0)
    maintainer = info.get("Maintainer")
    first = info.get("FirstSubmitted")
    age_days = (datetime.now(timezone.utc) - datetime.fromtimestamp(first, tz=timezone.utc)).days if first else None
    age_str = f"{age_days}d old" if age_days is not None else "age unknown"
    notes.append(f"baseline: {votes} votes, popularity {pop:.2f}, {age_str}, maintainer={sanitize(maintainer) or 'none'}")

    if maintainer is None:
        score -= 30
        notes.append("orphaned: no maintainer")

    unscanned = pkgbuild_flags is None
    all_flags = (pkgbuild_flags or []) + (aux_flags or []) + (coverage_flags or [])

    if votes < 5 and pop < 0.5:
        score -= 15
        notes.append(f"very low adoption ({votes} votes, popularity {pop:.2f})")
    elif votes >= 50 and not all_flags:
        # Popularity/age is not a mitigation for an actual code-execution
        # finding - a compromised popular package is the primary threat
        # this tool exists to catch, so don't let adoption offset it.
        score += 10
        notes.append(f"well-adopted ({votes} votes)")

    if info.get("OutOfDate"):
        ood = datetime.fromtimestamp(info["OutOfDate"], tz=timezone.utc)
        days = (datetime.now(timezone.utc) - ood).days
        penalty = min(20, 5 + days // 30)
        score -= penalty
        notes.append(f"flagged out-of-date {days}d ago and still unresolved")

    if age_days is not None and age_days < 30:
        score -= 10
        notes.append(f"brand new package ({age_days}d old)")

    if unscanned:
        score -= 20
        notes.append("PKGBUILD could NOT be fetched - it was NOT scanned; this score is "
                      "metadata-only and must not be read as 'clean'")
    for f in all_flags:
        score -= f["penalty"]
        line_suffix = f" -> {f['line']}" if verbose else ""
        count_suffix = f" [x{f['count']}]" if f.get("count", 1) > 1 else ""
        source = f.get("source", "PKGBUILD")
        notes.append(f"{source}: {f['desc']} (line {f['line_no']}){count_suffix}{line_suffix}")

    if typosquat_target:
        established = age_days is not None and age_days >= 1000 and votes >= 5
        if established:
            score -= 10
            notes.append(
                f"name resembles official package '{typosquat_target}', but this package is "
                f"well-established ({age_days}d old, {votes} votes) - likely a coincidence, not a typosquat"
            )
        else:
            score -= 25
            notes.append(f"name closely resembles official package '{typosquat_target}' - possible typosquat, treat with real caution")

    if handoff:
        penalty = 15
        if handoff["commits_since"] <= 3:
            penalty += 10
        if handoff["since_takeover_days"] <= 90:
            penalty += 10
        score -= min(penalty, 35)
        notes.append(
            f"possible maintainer handoff: '{handoff['new_identity_name']}' took over after "
            f"{handoff['gap_days']}d of dormancy - {handoff['commits_since']} commit(s) since, "
            f"{handoff['since_takeover_days']}d ago"
        )
    elif history_unavailable:
        notes.append("commit history unavailable - the maintainer-handoff check did not run")

    score = max(0, min(100, score))

    # A severe PKGBUILD finding is a ceiling, not just an addend - no
    # combination of votes/age/popularity should be able to buy a package's
    # way out of the bucket a remote-code-execution flag puts it in.
    if unscanned:
        score = min(score, 60)
    if all_flags:
        worst = max(f["penalty"] for f in all_flags)
        if worst >= 30:
            score = min(score, 24)
        elif worst >= 20:
            score = min(score, 49)

    return score, notes

# --- PKGBUILD explainer ------------------------------------------------
# Static, best-effort line annotations for the prepare()/build()/check()/
# package() functions. This never executes the PKGBUILD - only regex-reads
# it - because the whole point is understanding it BEFORE trusting it
# enough to run through makepkg.

LINE_ANNOTATIONS = [
    (r'^cd\s+"?\$srcdir', "moves into the extracted source directory"),
    (r'^cd\s+"?\$pkgdir', "moves into the packaging directory (unusual here; normally only used inside package())"),
    (r'\./configure\b', "runs an autotools 'configure' script to set up the build"),
    (r'^\s*make\b.*\binstall\b', "installs the compiled output into the packaging directory"),
    (r'^\s*make\b', "compiles the project with make"),
    (r'\bcmake\b.*-B\s', "configures the build using CMake"),
    (r'\bninja\b', "builds using Ninja (usually paired with CMake or Meson)"),
    (r'\bmeson\s+setup\b', "configures the build using Meson"),
    (r'\bcargo\s+build\b', "compiles a Rust project with Cargo"),
    (r'\bgo\s+build\b', "compiles a Go project"),
    (r'\bpip\s+install\b.*--root', "installs a Python package into the packaging directory"),
    (r'\bnpm\s+(ci|install)\b', "installs Node.js dependencies"),
    (r'\binstall\s+-D\S*m\s*0?7\d\d', "installs a file as an executable into the package"),
    (r'\binstall\s+-D\S*m\s*0?6\d\d', "installs a file as regular data/config into the package"),
    (r'\bstrip\b', "strips debug symbols from a compiled binary"),
    (r'\bsed\s+-i\b', "edits a file in place - worth checking what it actually changes"),
    (r'\bpatch\s+-p', "applies a patch file to the source before building"),
    (r'\bln\s+-s\b', "creates a symlink"),
    (r'\brm\s+-rf\b', "recursively force-deletes files - check the path is scoped to a build dir, not somewhere broader"),
    (r'\bchmod\s+[0-7]?[2-7][0-7]{3}\b', "!! sets a setuid/setgid bit (numeric mode) - makes a binary run with its owner's (often root's) privileges no matter who runs it"),
    (r'\bsudo\b', "!! runs a command as root - makepkg never needs this; a legitimate PKGBUILD never does this"),
    (r'\bcurl\b|\bwget\b', "downloads something at build time - normally everything downloaded should already be listed in source=() instead, so this is worth a second look"),
    (r'\bchmod\b.*\+s', "!! sets a setuid/setgid bit - makes a binary run with its owner's (often root's) privileges no matter who runs it"),
    (r'\beval\b', "!! runs a dynamically-built command - hides what actually executes"),
