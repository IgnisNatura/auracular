def use_color():
    return sys.stdout.isatty()

# Every C0 control except tab/newline, DEL, and the full C1 control block
# (\x80-\x9f) - the earlier version of this stopped at \x1f/\x7f and missed
# \x0d (carriage return, usable for an overwrite-line display trick) and the
# 8-bit C1 controls (e.g. U+009B, a single-codepoint form of CSI/ESC-[).
CONTROL_CHARS_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")

def sanitize(text):
    """Strip control characters (including ESC and its 8-bit C1 form, which
    defangs any ANSI escape sequence) from text that ultimately comes from
    an untrusted package - its AUR description, PKGBUILD content, or git
    author name. Without this, a malicious package could use terminal
    escape sequences to hide/rewrite what this tool prints about it, or
    \\r to overwrite a line's visible content. Newlines and tabs are left
    alone; this only removes characters with no legitimate display use in a
    one-line note or table cell."""
    if text is None:
        return text
    return CONTROL_CHARS_RE.sub("", str(text))

